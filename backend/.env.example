# ═══════════════════════════════════════════════════════════════
# LOOM – Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Shopify ──────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# ── PostEx ───────────────────────────────────────────────────
POSTEX_TOKEN=

# ── App URL (your PythonAnywhere URL after deploy) ──────────
APP_URL=https://yourusername.pythonanywhere.com

# ── Database (optional – defaults to loom.db in same folder) ─
DATABASE_PATH=
