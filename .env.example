# Copy to .env. Never commit .env or the data directory.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Required in production: a stable, independently backed-up 32-byte base64 key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Required in production for first-run setup; minimum 24 characters. Keep private.
SETUP_TOKEN=
# Set to the exact HTTPS origin in production, e.g. https://packing.yourdomain.com
PUBLIC_URL=
# Optional: reverse proxies (e.g. 1 for one trusted proxy). Default 0.
TRUST_PROXY=0
BACKUP_RETENTION_DAYS=14
# Optional initial import window. Shopify read_orders is limited to 60 days.
SHOPIFY_IMPORT_DAYS=60
SHOPIFY_API_VERSION=2026-01
# Shopify credentials are entered in Settings and encrypted in the database.
# Do not put Admin API tokens in browser/VITE environment variables.
